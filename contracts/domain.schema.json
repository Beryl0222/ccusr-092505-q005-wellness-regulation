{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "疗愈服务合规巡检库领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "ENTITY_REGISTERED",
        "LICENSE_REGISTERED",
        "LICENSE_VERIFIED",
        "LICENSE_EXPIRED",
        "OFFER_PUBLISHED",
        "OFFER_CAPTURED",
        "PRACTITIONER_REGISTERED",
        "PUBLICITY_VERSIONED",
        "BOUNDARY_DETERMINED",
        "EVIDENCE_CAPTURED",
        "EVIDENCE_SEALED",
        "COMPLAINT_FILED",
        "CASE_ASSIGNED",
        "CASE_COORDINATED",
        "CASE_NOTIFIED",
        "INSPECTION_SCHEDULED",
        "INSPECTION_RECORDED",
        "REMEDIATION_ORDERED",
        "REMEDIATION_EXTENDED",
        "REVIEW_CLOSED",
        "RESTRICTION_IMPOSED",
        "SERVICE_RESTARTED",
        "PENALTY_ISSUED",
        "APPEAL_REVOKED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "business_entity",
        "provider_license",
        "service_offer",
        "practitioner",
        "publicity_version",
        "evidence",
        "complaint",
        "inspection_case",
        "inspection_task",
        "remediation_plan",
        "penalty"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
