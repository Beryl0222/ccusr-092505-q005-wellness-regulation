{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "疗愈服务合规巡检库领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "PROVIDER_REGISTERED",
        "LICENSE_VERIFIED",
        "LICENSE_RENEWED",
        "PROVIDER_ORDER_BLOCKED",
        "PROVIDER_ORDER_RESTORED",
        "SERVICE_CATEGORY_DEFINED",
        "NEGATIVE_LIST_UPDATED",
        "OFFER_REGISTERED",
        "OFFER_CAPTURED",
        "PRICING_TERMS_PUBLISHED",
        "PRACTITIONER_REGISTERED",
        "SERVICE_RENDERED",
        "CONSUMER_AUTHORIZATION_GRANTED",
        "CONSUMER_AUTHORIZATION_REVOKED",
        "EVIDENCE_SEALED",
        "COMPLAINT_FILED",
        "CASE_ASSIGNED",
        "CASE_REMEDIATION_STARTED",
        "CASE_JURISDICTION_LINKED",
        "CASE_NOTIFIED_OF_VERSION",
        "CASE_PERSONAL_INFO_ACCESSED",
        "REMEDIATION_ORDERED",
        "REMEDIATION_DEADLINE_EXTENDED",
        "REVIEW_PASSED",
        "REVIEW_FAILED",
        "CASE_APPEALED",
        "CASE_WITHDRAWN",
        "CASE_PENALTY_ATTACHED",
        "PENALTY_ISSUED",
        "REVIEW_CLOSED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "provider",
        "provider_license",
        "service_category",
        "service_offer",
        "practitioner",
        "service_occurrence",
        "consumer_authorization",
        "evidence_record",
        "inspection_case",
        "remediation_plan",
        "penalty"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
